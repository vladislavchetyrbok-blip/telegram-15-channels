# Aphrodite / Zodiac environment example.
# Documentation only. Do not paste production secrets into this file.
# Use safe placeholders, keep real values in Vercel/GitHub/local secret stores.

# App / Public URLs
APP_URL=<local-or-public-app-url>
NEXT_PUBLIC_APP_URL=<public-app-url>
NEXT_PUBLIC_GITHUB_ACTIONS_URL=<github-actions-url>
NEXT_PUBLIC_VERCEL_ENV=<development-preview-or-production>

# Dashboard / Admin auth
APHRODITE_ADMIN_LOGIN=<dashboard-admin-login>
APHRODITE_ADMIN_PASSWORD=<dashboard-admin-password-placeholder>
APHRODITE_SESSION_SECRET=<long-random-dashboard-session-secret>
ADMIN_AUTH_ENABLED=false
ADMIN_PASSWORD=<legacy-admin-password-placeholder>
ADMIN_SESSION_SECRET=<legacy-admin-session-secret-placeholder>
ADMIN_SESSION_MAX_AGE_DAYS=14
ADMIN_REPORTS_ENABLED=false
ADMIN_TELEGRAM_CHAT_ID=<admin-telegram-chat-id-placeholder>

# Telegram Bot / Mini App
# TELEGRAM_BOT_TOKEN is required for production Telegram operations.
TELEGRAM_BOT_TOKEN=<set-in-secret-store-only>
TELEGRAM_BOT_MODE=single_bot
TELEGRAM_DRY_RUN=true
TELEGRAM_REAL_PUBLISH_ENABLED=false
TELEGRAM_REAL_SENDING_ENABLED=false
TELEGRAM_LIVE_PUBLISH=false
TELEGRAM_TEST_PUBLISH_MODE=mock
TELEGRAM_TEST_TARGET_CHAT_ID=<manual-test-chat-id-placeholder>
ZODIAC_GENERAL_CHANNEL_ID=<zodiac-general-channel-id-placeholder>
ZODIAC_ADMIN_ALERT_CHAT_ID=<zodiac-admin-alert-chat-id-placeholder>
ZODIAC_MINIAPP_SMOKE_URL=<optional-local-smoke-url>

# Database / Supabase
# DATABASE_URL is required for production DB-backed storage and migration checks.
DATABASE_URL=<set-in-production-secret-store-only>
PGSSLMODE=require
PUBLISH_DUE_STORE=json
PUBLISH_POSTS_TABLE=posts
NEXT_PUBLIC_SUPABASE_URL=<supabase-public-url-placeholder>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key-placeholder>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key-placeholder>
SUPABASE_DATABASE_URL=<supabase-database-url-placeholder>

# Publishing / dry-run / live safety flags
PUBLISH_DUE_DRY_RUN=true
PUBLISH_DUE_REAL_PUBLISH_ENABLED=false
PUBLISH_DUE_MAX_PER_RUN=1
PUBLISH_DUE_STATUSES=scheduled,draft,approved,ready_to_publish
PUBLISH_DUE_RUN_ID=<optional-run-id-placeholder>
PUBLISH_DUE_SOURCE=local
AUTOPUBLISH_ENABLED=false
AUTOPUBLISH_WEEKLY_ENABLED=false
AUTOPUBLISH_BASE_URL=<autopublish-base-url-placeholder>
AUTOPUBLISH_API_BASE=<autopublish-api-base-placeholder>
AUTOPUBLISH_WORKER_INTERVAL_MS=300000
AUTOPUBLISH_DAILY_LIMIT_PER_CHANNEL=1
AUTOPUBLISH_MAX_POSTS_PER_DAY=15
AUTOPUBLISH_TIME_START=09:00
AUTOPUBLISH_TIME_END=21:00
AUTOPUBLISH_TIME=09:00
AUTOPUBLISH_DAYS=1,3
AUTOPUBLISH_TIMEZONE=Europe/Kyiv
ZODIAC_LEDGER_GIT_PERSIST=false

# Analytics
ZODIAC_ANALYTICS_REDIS_URL=<redis-url-placeholder>
ZODIAC_ANALYTICS_REDIS_TOKEN=<redis-token-placeholder>
NEXT_PUBLIC_ZODIAC_PROFILE_SYNC_ENABLED=false
NEXT_PUBLIC_ZODIAC_PROFILE_SYNC_READ_ENABLED=false
NEXT_PUBLIC_ZODIAC_PROFILE_SYNC_WRITE_ENABLED=false

# Backup / restore
BACKUP_LOCATION=<manual-backup-location-placeholder>
BACKUP_FRESHNESS_MAX_HOURS=24
BACKUP_RESTORE_REHEARSAL_REQUIRED=true
CONFIRM_MIRROR_SYNC=false
CONFIRM_SUPABASE_RECONCILIATION_APPLY=NO

# Launch gates / owner approval
APHRODITE_PRODUCTION_LAUNCH_APPROVED=false
APHRODITE_OWNER_MANUAL_REVIEW_REQUIRED=true
PUBLIC_LAUNCH_APPROVED=false
OWNER_MANUAL_REVIEW_REQUIRED=true
SOFT_LAUNCH_APPROVED=false

# Development / QA
NODE_ENV=development
APP_ENV=development
LOCAL_AI_PROVIDER=lmstudio
LOCAL_AI_BASE_URL=<local-ai-base-url-placeholder>
LOCAL_AI_MODEL=<local-ai-model-placeholder>
LOCAL_AI_TEMPERATURE=0.7
LOCAL_AI_MAX_TOKENS=800
GEMINI_API_KEY=<gemini-api-key-placeholder>
IMAGE_PROVIDER=placeholder
IMAGE_FALLBACK_PROVIDER=placeholder
IMAGE_AI_ENABLED=false
IMAGE_GENERATION_MODE=mock
IMAGE_HARDWARE_PROFILE=local
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
IMAGE_PREMIUM_STYLE=false
COMFYUI_URL=<comfyui-url-placeholder>
CHROME_PATH=<optional-chrome-path>
GOOGLE_CHROME_BIN=<optional-google-chrome-bin>
CHROMIUM_PATH=<optional-chromium-path>
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=<optional-playwright-chromium-path>

# Legacy env names
# ZODIAC_DASHBOARD_SESSION_SECRET is legacy/non-authoritative after Package 225.
ZODIAC_DASHBOARD_AUTH_ENABLED=false
ZODIAC_DASHBOARD_ADMIN_PASSWORD_SHA256=<legacy-dashboard-password-hash-placeholder>
ZODIAC_DASHBOARD_SESSION_SECRET=<legacy-dashboard-session-secret-placeholder>

# Production reminder
# Production launch remains blocked until DATABASE_URL, TELEGRAM_BOT_TOKEN,
# backup freshness, real-device QA, Telegram WebView QA, content/CTA review,
# and explicit owner approval are manually complete.
